APP_ENVIRONMENT=development

# Inert today (same-origin deployment via Caddy path-split) -- kept real
# and typed per CLAUDE.md. A future domain split only needs a value change.
CORS_ORIGINS=https://einteilung.hochamt.at.dev.schimpl.cc

# Real DB lives at the repo-root database/database.sqlite, bind-mounted
# into the container at /database (see deploy/quadlets/dev/osa-api.container).
DATABASE_URL=sqlite:////database/database.sqlite

# JWT signing secret -- must be at least 32 characters. Generate a real
# value with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-32-plus-character-secret

# Session/JWT lifetimes and password policy -- defaults shown below.
SESSION_LIFETIME_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=120
REFRESH_TOKEN_LIFETIME_DAYS=7
PASSWORD_MIN_LENGTH=8

# IANA timezone used to interpret naive wall-clock columns (e.g.
# Performance.schedule). Mirrors Legacy's config('app.timezone').
APP_TIMEZONE=Europe/Vienna

# SMTP transport -- required before the mailer can actually send anything
# (registration notice, verify-email, password-reset mail). Unset is fine
# until a feature that sends mail is actually exercised (see
# require_setting() in config.py).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=null
SMTP_PASSWORD=null

# Mail sender identity + disponent contact address -- defaults shown below,
# taken 1:1 from Legacy's config/mail.php / config/osa.php.
SMTP_FROM_EMAIL=no-reply@hochamt.at
SMTP_FROM_NAME=Kirchenmusik St. Augustin
MAIL_DISPONENT=einteilung@hochamt.at

# Mail kill-switch: once this many recipients (to+cc+bcc combined) were
# mailed within the rolling period below, sending switches globally to pure
# logging (no error, no crash). Defaults 1:1 Legacy's config/mail.php
# (limit.periodDays / limit.allMessagesThreshold).
MAIL_KILL_SWITCH_PERIOD_DAYS=30
MAIL_KILL_SWITCH_THRESHOLD=950

# Token lifetimes for the two mail-driven flows.
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=60

# Google OAuth ID-token audience -- required before Google-Login/-Link works.
GOOGLE_CLIENT_ID=

# Frontend URLs the mailer embeds in verify-email/password-reset links --
# required before those two mails can be built (see require_setting()).
FRONTEND_VERIFY_EMAIL_URL=https://einteilung.hochamt.at.dev.schimpl.cc/verify-email
FRONTEND_RESET_PASSWORD_URL=https://einteilung.hochamt.at.dev.schimpl.cc/reset-password

# Bare hostname of the dedicated short-URL redirect subdomain (see the
# go.-domain Caddy vhost). Prod sets this to "go.hochamt.at" instead --
# defaults to that value here too if unset.
SHORTURL_DOMAIN=go.hochamt.at.dev.schimpl.cc
