APP_ENVIRONMENT=development

# Inert today (same-origin deployment via Caddy path-split) -- kept real
# and typed per CLAUDE.md. A future domain split only needs a value change.
CORS_ORIGINS=https://einteilung.hochamt.at.dev.schimpl.cc

# Real DB lives at the repo-root database/database.sqlite, bind-mounted
# into the container at /database (see deploy/quadlets/dev/osa-api.container).
DATABASE_URL=sqlite:////database/database.sqlite

# JWT signing secret -- must be at least 32 characters. Generate a real
# value with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-32-plus-character-secret

# SMTP -- required before the mailer can actually send anything (registration
# notice, verify-email, password-reset mail). Unset is fine until a feature
# that sends mail is actually exercised (see require_setting() in config.py).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=null
SMTP_PASSWORD=null

# Google OAuth ID-token audience -- required before Google-Login/-Link works.
GOOGLE_CLIENT_ID=

# Frontend URLs the mailer embeds in verify-email/password-reset links --
# required before those two mails can be built (see require_setting()).
FRONTEND_VERIFY_EMAIL_URL=https://einteilung.hochamt.at.dev.schimpl.cc/verify-email
FRONTEND_RESET_PASSWORD_URL=https://einteilung.hochamt.at.dev.schimpl.cc/reset-password
