APP_ENVIRONMENT=development

# Inert today (same-origin deployment via Caddy path-split) -- kept real
# and typed per CLAUDE.md. A future domain split only needs a value change.
CORS_ORIGINS=https://einteilung.hochamt.at.dev.schimpl.cc

# Real DB lives at the repo-root database/database.sqlite, bind-mounted
# into the container at /database (see deploy/quadlets/dev/osa-api.container).
DATABASE_URL=sqlite+aiosqlite:////database/database.sqlite

# JWT signing secret -- must be at least 32 characters. Generate a real
# value with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-32-plus-character-secret
