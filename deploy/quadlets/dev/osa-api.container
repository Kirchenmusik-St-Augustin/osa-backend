[Unit]
Description=OSA Backend API (Dev)
After=osa-api-dev-build.service caddy.service
Requires=osa-api-dev-build.service

[Container]
ContainerName=osa-api
Image=osa-api-dev.build
PublishPort=127.0.0.1:21000:8000
UserNS=keep-id
Environment=WATCHFILES_FORCE_POLLING=true
Volume=%h/projects/osa-fastapi-vue/osa-backend:/app:Z
Volume=%h/projects/osa-fastapi-vue/database:/database:Z
EnvironmentFile=%h/.env/osa-api.env

HealthCmd=python3 -c 'import urllib.request; urllib.request.urlopen("http://localhost:8000/")'
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
